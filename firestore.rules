rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isGodleyAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('(?i)^travis@godleyciders\\.com$') ||
        request.auth.token.email.matches('(?i)^travis@godlyciders\\.com$') ||
        request.auth.token.email.matches('(?i)^.*@godleyciders\\.com$') ||
        request.auth.token.email.matches('(?i)^.*@godlyciders\\.com$')
      );
    }
    function isSignedIn() { return request.auth != null; }
    
    function isValidClubLead(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'tier', 'deliveryPreference', 'dripPreferences', 'status', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 0 && data.email.size() <= 150
          && data.phone is string && data.phone.size() <= 20
          && data.tier is string && data.tier.size() > 0 && data.tier.size() <= 20
          && data.deliveryPreference is string
          && data.dripPreferences is map
          && data.status is string;
    }
    
    match /club_leads/{leadId} {
      allow create: if true;
      allow read: if isGodleyAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update: if isGodleyAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isGodleyAdmin();
    }

    match /admin_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isGodleyAdmin();
    }

    match /email_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isGodleyAdmin();
    }

    match /visitor_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isGodleyAdmin();
    }

    match /wholesale_inquiries/{inquiryId} {
      allow read: if isGodleyAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(inquiryId) && (isGodleyAdmin() || (isSignedIn() && incoming().email == request.auth.token.email));
      allow update: if isGodleyAdmin();
      allow delete: if isGodleyAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isGodleyAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && (isGodleyAdmin() || (incoming().customerId == request.auth.uid || incoming().userId == request.auth.uid || incoming().customerEmail == request.auth.token.email));
      allow read: if isGodleyAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow update: if isGodleyAdmin();
      allow delete: if isGodleyAdmin();
    }

    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isGodleyAdmin();
    }

    match /shop_reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isGodleyAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    match /blog_comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if isGodleyAdmin();
    }

    match /tasting_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isGodleyAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
