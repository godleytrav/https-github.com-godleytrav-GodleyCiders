{
  "entities": {
    "ClubLead": {
      "title": "ClubLead",
      "description": "User inquiring to join a membership tier",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "tier": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "tier", "createdAt"]
    },
    "WholesaleInquiry": {
      "title": "WholesaleInquiry",
      "description": "Wholesale buyer account, lead capture, California compliance documentation, and approval status",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 150 },
        "contactName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "maxLength": 60 },
        "status": { "enum": ["lead", "pending", "hold", "approved", "rejected"] },
        "docsSubmitted": { "type": "boolean" },
        "abcLicenseNumber": { "type": "string", "maxLength": 80 },
        "resaleLicenseNumber": { "type": "string", "maxLength": 80 },
        "taxId": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "billingAddress": { "type": "string", "maxLength": 300 },
        "net30Status": { "enum": ["none", "requested", "approved", "denied"] },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "contactName", "email", "phone", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A cider product available for sale, synced from Custom Program",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number", "description": "Inventory synced from Custom Program" },
        "isAvailable": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "stock", "isAvailable", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "An order created from the web, to be ingested by the Custom Program",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "number" },
              "priceAtPurchase": { "type": "number" }
            },
            "required": ["productId", "quantity", "priceAtPurchase"]
          }
        },
        "totalAmount": { "type": "number" },
        "status": { "enum": ["pending", "paid", "fulfilled", "cancelled"] },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status", "createdAt", "updatedAt"]
    },
    "LiveLabel": {
      "title": "LiveLabel",
      "description": "AR interactive bottle label configuration with QR code identifier and multimedia assets",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "vintage": { "type": "string" },
        "targetImageUrl": { "type": "string" },
        "augmentedMediaType": { "enum": ["video", "canvas_effect", "artwork_layer"] },
        "augmentedMediaUrl": { "type": "string" },
        "canvasEffectType": { "type": "string" },
        "audioNarrationUrl": { "type": "string" },
        "audioTitle": { "type": "string" },
        "terroirNotes": { "type": "object" },
        "ctaType": { "type": "string" },
        "ctaLabel": { "type": "string" },
        "ctaUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "name", "targetImageUrl", "active"]
    }
  },
  "firestore": {
    "/club_leads/{leadId}": {
      "schema": { "$ref": "#/entities/ClubLead" },
      "description": "Inquiries for club membership."
    },
    "/wholesale_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/WholesaleInquiry" },
      "description": "Inquiries from businesses for wholesale allocation."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Cider inventory sourced from local CRM"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders created on the web to be processed by CRM"
    },
    "/live_labels/{labelId}": {
      "schema": { "$ref": "#/entities/LiveLabel" },
      "description": "Interactive AR bottle label configurations and multimedia targets"
    }
  }
}
